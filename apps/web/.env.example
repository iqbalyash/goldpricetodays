# Runtime connection. On Supabase use the transaction pooler (port 6543):
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/goldpricetodays"

# Migrations and seed. On Supabase use the direct connection (port 5432), not the pooler.
# Falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/goldpricetodays"

# Bearer token required by GET/POST /api/cron/update-prices. Vercel Cron sends this automatically.
CRON_SECRET="replace-with-a-long-random-string"

# Optional. Enables the 30-day XAU history chart. Never expose this in client code.
GOLD_API_KEY=""
